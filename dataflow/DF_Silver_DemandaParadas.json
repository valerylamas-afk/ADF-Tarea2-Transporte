{
	"name": "DF_Silver_DemandaParadas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_DemandaParadas",
						"type": "DatasetReference"
					},
					"name": "DemandaBronze"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "LimpiarTextoDemanda"
				},
				{
					"name": "ConvertirDatosDemanda"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string,",
				"          abordajes_manuales as string,",
				"          estimacion_abordajes as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DemandaBronze",
				"DemandaBronze derive(DemandaId = trim(DemandaId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          ParadaHistoricaId = trim(ParadaHistoricaId),",
				"          Franja = upper(trim(Franja)),",
				"          Metodo = upper(trim(Metodo))) ~> LimpiarTextoDemanda",
				"LimpiarTextoDemanda derive(FechaServicio = iif(     isInteger(trim(FechaServicio)),     addDays(toDate('1899-12-30'), toInteger(trim(FechaServicio))),     iif(         instr(trim(FechaServicio), '/') > 0,         toDate(trim(FechaServicio), 'dd/MM/yyyy'),         toDate(trim(FechaServicio), 'yyyy-MM-dd')     ) )) ~> ConvertirDatosDemanda"
			]
		}
	}
}