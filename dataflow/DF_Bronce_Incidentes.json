{
	"name": "DF_Bronce_Incidentes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Incidentes",
						"type": "DatasetReference"
					},
					"name": "IncidentesCSV"
				},
				{
					"dataset": {
						"referenceName": "DS_XLS_Incidentes_2022",
						"type": "DatasetReference"
					},
					"name": "IncidentesExcel2022"
				},
				{
					"dataset": {
						"referenceName": "DS_XLS_Incidentes_2023",
						"type": "DatasetReference"
					},
					"name": "IncidentesExcel2023"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_ERP_Incidentes",
						"type": "DatasetReference"
					},
					"name": "IncidentesERP"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_Incidentes",
						"type": "DatasetReference"
					},
					"name": "DestinoBronzeIncidentes"
				}
			],
			"transformations": [
				{
					"name": "PrepararIncidentesCSV"
				},
				{
					"name": "PrepararFechasCSV"
				},
				{
					"name": "PrepararIncidentesExcel2022"
				},
				{
					"name": "PrepararFechasExcel2022"
				},
				{
					"name": "PrepararIncidentesExcel2023"
				},
				{
					"name": "PrepararFechasExcel2023"
				},
				{
					"name": "PrepararIncidentesERP"
				},
				{
					"name": "UnionIncidentes2022"
				},
				{
					"name": "UnionIncidentes2023"
				},
				{
					"name": "UnionIncidentesERP"
				},
				{
					"name": "SeleccionarColumnasIncidentes"
				},
				{
					"name": "PrepararRelacionesIncidentes"
				},
				{
					"name": "FiltrarRutasAfectadas"
				},
				{
					"name": "SepararRutas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> IncidentesCSV",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> IncidentesExcel2022",
				"source(output(",
				"          id_incidente as string,",
				"          tipo as string,",
				"          severidad as string,",
				"          fecha_inicio as string,",
				"          hora_inicio as string,",
				"          fecha_fin as string,",
				"          hora_fin as string,",
				"          fecha_registro as string,",
				"          rutas_afectadas as string,",
				"          vehiculo_afectado as string,",
				"          descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> IncidentesExcel2023",
				"source(output(",
				"          AnioFuente as integer,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as timestamp,",
				"          FechaHoraFin as timestamp,",
				"          FechaHoraRegistro as timestamp,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> IncidentesERP",
				"IncidentesCSV select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          fecha_inicio,",
				"          hora_inicio,",
				"          fecha_fin,",
				"          hora_fin,",
				"          fecha_registro,",
				"          rutas_afectadas,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> PrepararIncidentesCSV",
				"PrepararIncidentesCSV derive(FechaHoraInicio = concat(trim(fecha_inicio), ' ', trim(hora_inicio)),",
				"          FechaHoraFin = concat(trim(fecha_fin), ' ', trim(hora_fin)),",
				"          FechaHoraRegistro = trim(fecha_registro),",
				"          AnioFuente = substring(trim(fecha_inicio), 7, 4)) ~> PrepararFechasCSV",
				"IncidentesExcel2022 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          TipoIncidente = tipo,",
				"          Severidad = severidad,",
				"          fecha_inicio,",
				"          hora_inicio,",
				"          fecha_fin,",
				"          hora_fin,",
				"          fecha_registro,",
				"          rutas_afectadas,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> PrepararIncidentesExcel2022",
				"PrepararIncidentesExcel2022 derive(FechaHoraInicio = concat(     trim(fecha_inicio),     ' ',     iif(         instr(trim(hora_inicio), ' ') > 0,         substring(trim(hora_inicio), 12, 8),         trim(hora_inicio)     ) ),",
				"          FechaHoraFin = concat(     trim(fecha_fin),     ' ',     iif(         instr(trim(hora_fin), ' ') > 0,         substring(trim(hora_fin), 12, 8),         trim(hora_fin)     ) ),",
				"          FechaHoraRegistro = trim(fecha_registro),",
				"          AnioFuente = '2022') ~> PrepararFechasExcel2022",
				"IncidentesExcel2023 select(mapColumn(",
				"          IncidenteId = id_incidente,",
				"          IncidenteId = tipo,",
				"          Severidad = severidad,",
				"          fecha_inicio,",
				"          hora_inicio,",
				"          fecha_fin,",
				"          hora_fin,",
				"          fecha_registro,",
				"          rutas_afectadas,",
				"          VehiculoId = vehiculo_afectado,",
				"          Descripcion = descripcion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> PrepararIncidentesExcel2023",
				"PrepararIncidentesExcel2023 derive(FechaHoraInicio = concat(     trim(fecha_inicio),     ' ',     iif(         instr(trim(hora_inicio), ' ') > 0,         substring(trim(hora_inicio), 12, 8),         trim(hora_inicio)     ) ),",
				"          FechaHoraFin = concat(     trim(fecha_fin),     ' ',     iif(         instr(trim(hora_fin), ' ') > 0,         substring(trim(hora_fin), 12, 8),         trim(hora_fin)     ) ),",
				"          FechaHoraRegistro = trim(fecha_registro),",
				"          AnioFuente = '2023') ~> PrepararFechasExcel2023",
				"IncidentesERP derive(AnioFuente = toString(AnioFuente),",
				"          FechaHoraInicio = toString(FechaHoraInicio, 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraFin = toString(FechaHoraFin, 'yyyy-MM-dd HH:mm:ss'),",
				"          FechaHoraRegistro = toString(FechaHoraRegistro, 'yyyy-MM-dd HH:mm:ss')) ~> PrepararIncidentesERP",
				"PrepararFechasCSV, PrepararFechasExcel2022 union(byName: true)~> UnionIncidentes2022",
				"UnionIncidentes2022, PrepararFechasExcel2023 union(byName: true)~> UnionIncidentes2023",
				"UnionIncidentes2023, PrepararIncidentesERP union(byName: true)~> UnionIncidentesERP",
				"SepararRutas select(mapColumn(",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          VehiculoId,",
				"          Descripcion,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          AnioFuente",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SeleccionarColumnasIncidentes",
				"UnionIncidentesERP select(mapColumn(",
				"          IncidenteId,",
				"          rutas_afectadas,",
				"          AnioFuente",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> PrepararRelacionesIncidentes",
				"PrepararRelacionesIncidentes filter(!isNull(rutas_afectadas) && trim(rutas_afectadas) != '') ~> FiltrarRutasAfectadas",
				"FiltrarRutasAfectadas derive(ListaRutas = split(trim(rutas_afectadas), '|')) ~> SepararRutas",
				"SeleccionarColumnasIncidentes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          TipoIncidente as string,",
				"          Severidad as string,",
				"          FechaHoraInicio as string,",
				"          FechaHoraFin as string,",
				"          FechaHoraRegistro as string,",
				"          VehiculoId as string,",
				"          Descripcion as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          IncidenteId,",
				"          TipoIncidente,",
				"          Severidad,",
				"          FechaHoraInicio,",
				"          FechaHoraFin,",
				"          FechaHoraRegistro,",
				"          VehiculoId,",
				"          Descripcion",
				"     )) ~> DestinoBronzeIncidentes"
			]
		}
	}
}