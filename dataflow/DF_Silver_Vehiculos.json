{
	"name": "DF_Silver_Vehiculos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_Vehiculos",
						"type": "DatasetReference"
					},
					"name": "VehiculosBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_DW_Silver_Vehiculos",
						"type": "DatasetReference"
					},
					"name": "VehiculosSilver"
				}
			],
			"transformations": [
				{
					"name": "LimpiarTextoVehiculos"
				},
				{
					"name": "ConvertirDatosVehiculos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> VehiculosBronze",
				"VehiculosBronze derive(VehiculoId = trim(VehiculoId),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          Estado = upper(trim(Estado))) ~> LimpiarTextoVehiculos",
				"LimpiarTextoVehiculos derive(CapacidadEfectiva = toInteger(trim(CapacidadEfectiva)),",
				"          VigenciaDesde = iif(     instr(trim(VigenciaDesde), '/') > 0,     toDate(trim(VigenciaDesde), 'dd/MM/yyyy'),     toDate(trim(VigenciaDesde), 'yyyy-MM-dd') ),",
				"          VigenciaHasta = iif(     instr(trim(VigenciaHasta), '/') > 0,     toDate(trim(VigenciaHasta), 'dd/MM/yyyy'),     toDate(trim(VigenciaHasta), 'yyyy-MM-dd') )) ~> ConvertirDatosVehiculos",
				"ConvertirDatosVehiculos sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SilverId as long,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> VehiculosSilver"
			]
		}
	}
}