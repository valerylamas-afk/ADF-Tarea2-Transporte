{
	"name": "DF_Silver_Vehiculos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_Vehiculos",
						"type": "DatasetReference"
					},
					"name": "VehiculosBronze"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "LimpiarTextoVehiculos"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> VehiculosBronze",
				"VehiculosBronze derive(VehiculoId = trim(VehiculoId),",
				"          Placa = upper(trim(Placa)),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          Estado = upper(trim(Estado)),",
				"          columna5 = ERROR_FUNCTION('')) ~> LimpiarTextoVehiculos"
			]
		}
	}
}