{
	"name": "DF_Silver_IncidenteRuta",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_IncidenteRuta",
						"type": "DatasetReference"
					},
					"name": "IncidenteRutaBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_DW_Silver_IncidenteRuta",
						"type": "DatasetReference"
					},
					"name": "DestinoSilverIncidenteRuta"
				}
			],
			"transformations": [
				{
					"name": "ConvertirTiposIncidenteRuta"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> IncidenteRutaBronze",
				"IncidenteRutaBronze derive(EsPrincipal = toBoolean(EsPrincipal)) ~> ConvertirTiposIncidenteRuta",
				"ConvertirTiposIncidenteRuta sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SilverId as long,",
				"          IncidenteId as string,",
				"          RutaHistoricaId as string,",
				"          EsPrincipal as boolean",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          IncidenteId,",
				"          RutaHistoricaId,",
				"          EsPrincipal",
				"     )) ~> DestinoSilverIncidenteRuta"
			]
		}
	}
}