{
	"name": "DF_Bronce_Vehiculos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Vehiculos",
						"type": "DatasetReference"
					},
					"name": "VehiculosCSV"
				},
				{
					"dataset": {
						"referenceName": "DS_Excel_Vehiculos2022",
						"type": "DatasetReference"
					},
					"name": "VehiculosExcel2022"
				},
				{
					"dataset": {
						"referenceName": "DS_Excel_Vehiculos2023",
						"type": "DatasetReference"
					},
					"name": "VehiculosExcel2023"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_Vehiculos_ERP",
						"type": "DatasetReference"
					},
					"name": "VehiculosSQL"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "SelectVehiculosCSV"
				},
				{
					"name": "SelectVehiculosExcel2023"
				},
				{
					"name": "SelectVehiculosSQL"
				},
				{
					"name": "DerivarTiposVehiculosSQL"
				},
				{
					"name": "UnionVehiculos2023"
				},
				{
					"name": "SelectVehiculosExcel2022"
				},
				{
					"name": "UnionVehiculos2022"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> VehiculosCSV",
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> VehiculosExcel2022",
				"source(output(",
				"          nro_bus as string,",
				"          placa as string,",
				"          tipo_bus as string,",
				"          capacidad as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> VehiculosExcel2023",
				"source(output(",
				"          AnioFuente as integer,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as integer,",
				"          VigenciaDesde as date,",
				"          VigenciaHasta as date,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> VehiculosSQL",
				"VehiculosCSV select(mapColumn(",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehiculosCSV",
				"VehiculosExcel2023 select(mapColumn(",
				"          VehiculoId = nro_bus,",
				"          Placa = placa,",
				"          TipoVehiculo = tipo_bus,",
				"          CapacidadEfectiva = capacidad,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehiculosExcel2023",
				"VehiculosSQL select(mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehiculosSQL",
				"SelectVehiculosSQL derive(AnioFuente = toString(AnioFuente),",
				"          CapacidadEfectiva = toString(CapacidadEfectiva),",
				"          VigenciaDesde = toString(VigenciaDesde),",
				"          VigenciaHasta = toString(VigenciaHasta)) ~> DerivarTiposVehiculosSQL",
				"UnionVehiculos2022, SelectVehiculosExcel2022 union(byName: true)~> UnionVehiculos2023",
				"VehiculosExcel2022 select(mapColumn(",
				"          nro_bus,",
				"          placa,",
				"          tipo_bus,",
				"          capacidad,",
				"          fecha_desde,",
				"          fecha_hasta,",
				"          estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectVehiculosExcel2022",
				"SelectVehiculosCSV union(byName: true)~> UnionVehiculos2022"
			]
		}
	}
}