{
	"name": "DF_Bronce_Rutas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Rutas",
						"type": "DatasetReference"
					},
					"name": "RutasCSV"
				},
				{
					"dataset": {
						"referenceName": "DS_Excel_Rutas2022",
						"type": "DatasetReference"
					},
					"name": "RutasExcel2022"
				},
				{
					"dataset": {
						"referenceName": "DS_Excel_Operacion2023",
						"type": "DatasetReference"
					},
					"name": "RutasExcel2023"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_Rutas_ERP",
						"type": "DatasetReference"
					},
					"name": "RutasSQL"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "SelectRutasSQL"
				},
				{
					"name": "SelectRutasCSV"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> RutasCSV",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> RutasExcel2022",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> RutasExcel2023",
				"source(output(",
				"          AnioFuente as integer,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RutasSQL",
				"RutasSQL select(mapColumn(",
				"          AnioFuente,",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRutasSQL",
				"RutasCSV select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRutasCSV"
			]
		}
	}
}