{
	"name": "DF_Bronce_Rutas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Rutas",
						"type": "DatasetReference"
					},
					"name": "RutasCSV"
				},
				{
					"dataset": {
						"referenceName": "DS_Excel_Rutas2022",
						"type": "DatasetReference"
					},
					"name": "RutasExcel2022"
				},
				{
					"dataset": {
						"referenceName": "DS_Excel_Rutas2022",
						"type": "DatasetReference"
					},
					"name": "RutasExcel2023"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_Rutas_ERP",
						"type": "DatasetReference"
					},
					"name": "RutasSQL"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_Rutas",
						"type": "DatasetReference"
					},
					"name": "SinkBronceRutas"
				}
			],
			"transformations": [
				{
					"name": "SelectRutasSQL"
				},
				{
					"name": "SelectRutasCSV"
				},
				{
					"name": "DerivarAnioRutasCSV"
				},
				{
					"name": "SelectRutasExcel2022"
				},
				{
					"name": "DerivarAnioRutas2022"
				},
				{
					"name": "SelectRutasExcel2023"
				},
				{
					"name": "DerivarAnioRutas2023"
				},
				{
					"name": "UnionRutas2022"
				},
				{
					"name": "UnionRutas2023"
				},
				{
					"name": "UnionBronceRutas"
				}
			],
			"scriptLines": [
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> RutasCSV",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> RutasExcel2022",
				"source(output(",
				"          cod_ruta as string,",
				"          nombre_ruta as string,",
				"          origen as string,",
				"          destino as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> RutasExcel2023",
				"source(output(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> RutasSQL",
				"RutasSQL select(mapColumn(",
				"          AnioFuente,",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRutasSQL",
				"RutasCSV select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRutasCSV",
				"SelectRutasCSV derive(AnioFuente = substring(VigenciaDesde, 6, 4)) ~> DerivarAnioRutasCSV",
				"RutasExcel2022 select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRutasExcel2022",
				"SelectRutasExcel2022 derive(AnioFuente = '2022') ~> DerivarAnioRutas2022",
				"RutasExcel2023 select(mapColumn(",
				"          CodigoRuta = cod_ruta,",
				"          NombreRuta = nombre_ruta,",
				"          Origen = origen,",
				"          Destino = destino,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectRutasExcel2023",
				"SelectRutasExcel2023 derive(AnioFuente = '2023') ~> DerivarAnioRutas2023",
				"DerivarAnioRutasCSV, DerivarAnioRutas2022 union(byName: true)~> UnionRutas2022",
				"UnionRutas2022, DerivarAnioRutas2023 union(byName: true)~> UnionRutas2023",
				"UnionRutas2023, SelectRutasSQL union(byName: true)~> UnionBronceRutas",
				"UnionBronceRutas sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          RutaHistoricaId as string,",
				"          CodigoRuta as string,",
				"          NombreRuta as string,",
				"          Origen as string,",
				"          Destino as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          RutaHistoricaId,",
				"          CodigoRuta,",
				"          NombreRuta,",
				"          Origen,",
				"          Destino,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> SinkBronceRutas"
			]
		}
	}
}