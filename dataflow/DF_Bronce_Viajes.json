				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ViajesExcel2022",
				"source(output(",
				"          id_viaje as string,",
				"          cod_ruta as string,",
				"          nro_bus as string,",
				"          fecha_servicio as string,",
				"          hora_programada as string,",
				"          hora_salida as string,",
				"          hora_llegada as string,",
				"          pasajeros_estimados as string,",
				"          km_recorridos as string,",
				"          estado_viaje as string,",
				"          tipo_metrica as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ViajesExcel2023",
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ViajesSQL",
				"ViajesCSV select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fec_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectCSV",
				"ViajesExcel2022 select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fecha_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectExcel2022",
				"ViajesExcel2023 select(mapColumn(",
				"          ViajeId = id_viaje,",
				"          RutaHistoricaId = cod_ruta,",
				"          VehiculoId = nro_bus,",
				"          FechaServicio = fecha_servicio,",
				"          HoraProgramada = hora_programada,",
				"          HoraSalida = hora_salida,",
				"          HoraLlegada = hora_llegada,",
				"          KmRecorridos = km_recorridos,",
				"          EstadoViaje = estado_viaje",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectExcel2023",
				"ViajesSQL select(mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectSQL",
				"SelectCSV, SelectExcel2022 union(byName: true)~> UnionCSV2022",
				"UnionCSV2022, SelectExcel2023 union(byName: true)~> UnionCSV2022y2023"
			]
		}
