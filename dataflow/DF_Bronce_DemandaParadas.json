{
	"name": "DF_Bronce_DemandaParadas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_DemandaParadas",
						"type": "DatasetReference"
					},
					"name": "DemandaCSV"
				},
				{
					"dataset": {
						"referenceName": "DS_XLS_DemandaParadas_2022",
						"type": "DatasetReference"
					},
					"name": "DemandaExcel2022"
				},
				{
					"dataset": {
						"referenceName": "DS_XLS_DemandaParadas_2023",
						"type": "DatasetReference"
					},
					"name": "DemandaExcel2023"
				},
				{
					"dataset": {
						"referenceName": "DS_SQL_ERP_DemandaParadas",
						"type": "DatasetReference"
					},
					"name": "DemandaSQL"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "SelectDemandaCSV"
				},
				{
					"name": "SelectDemandaExcel2022"
				},
				{
					"name": "SelectDemandaExcel2023"
				},
				{
					"name": "ConvertirTiposDemandaSQL"
				},
				{
					"name": "SelectDemandaSQL"
				},
				{
					"name": "UnionDemandaExcel"
				},
				{
					"name": "UnionDemandaCSVExcel"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fec_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          abordajes_manuales as string,",
				"          descensos_manuales as string,",
				"          demanda_no_atendida as string,",
				"          medicion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DemandaCSV",
				"source(output(",
				"          fecha_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          estimacion_abordajes as string,",
				"          estimacion_descensos as string,",
				"          demanda_no_atendida as string,",
				"          metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DemandaExcel2022",
				"source(output(",
				"          fecha_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          estimacion_abordajes as string,",
				"          estimacion_descensos as string,",
				"          demanda_no_atendida as string,",
				"          metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DemandaExcel2023",
				"source(output(",
				"          AnioFuente as integer,",
				"          DemandaId as string,",
				"          FechaServicio as date,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as integer,",
				"          Descensos as integer,",
				"          DemandaNoAtendida as integer,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DemandaSQL",
				"DemandaCSV select(mapColumn(",
				"          FechaServicio = fec_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          abordajes_manuales,",
				"          Descensos = descensos_manuales,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = medicion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectDemandaCSV",
				"DemandaExcel2022 select(mapColumn(",
				"          FechaServicio = fecha_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          estimacion_abordajes,",
				"          Descensos = estimacion_descensos,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = metodo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectDemandaExcel2022",
				"DemandaExcel2023 select(mapColumn(",
				"          FechaServicio = fecha_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          estimacion_abordajes,",
				"          Descensos = estimacion_descensos,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = metodo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectDemandaExcel2023",
				"DemandaSQL derive(AnioFuente = toString(AnioFuente),",
				"          FechaServicio = toString(FechaServicio),",
				"          ValidacionesTarjeta = toString(ValidacionesTarjeta),",
				"          Descensos = toString(Descensos),",
				"          DemandaNoAtendida = toString(DemandaNoAtendida)) ~> ConvertirTiposDemandaSQL",
				"ConvertirTiposDemandaSQL select(mapColumn(",
				"          AnioFuente,",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectDemandaSQL",
				"SelectDemandaExcel2022, SelectDemandaExcel2023 union(byName: true)~> UnionDemandaExcel",
				"UnionDemandaExcel, SelectDemandaCSV union(byName: true)~> UnionDemandaCSVExcel"
			]
		}
	}
}