{
	"name": "DF_Bronce_DemandaParadas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_DemandaParadas",
						"type": "DatasetReference"
					},
					"name": "DemandaCSV"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "SelectDemandaCSV"
				}
			],
			"scriptLines": [
				"source(output(",
				"          fec_servicio as string,",
				"          cod_ruta as string,",
				"          nro_parada as string,",
				"          franja as string,",
				"          abordajes_manuales as string,",
				"          descensos_manuales as string,",
				"          demanda_no_atendida as string,",
				"          medicion as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> DemandaCSV",
				"DemandaCSV select(mapColumn(",
				"          FechaServicio = fec_servicio,",
				"          RutaHistoricaId = cod_ruta,",
				"          ParadaHistoricaId = nro_parada,",
				"          Franja = franja,",
				"          abordajes_manuales,",
				"          Descensos = descensos_manuales,",
				"          DemandaNoAtendida = demanda_no_atendida,",
				"          Metodo = medicion",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectDemandaCSV"
			]
		}
	}
}