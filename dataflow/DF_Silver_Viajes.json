{
	"name": "DF_Silver_Viajes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_Viajes",
						"type": "DatasetReference"
					},
					"name": "ViajesBronze"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_DW_Silver_Viajes",
						"type": "DatasetReference"
					},
					"name": "DestinoSilverViajes"
				}
			],
			"transformations": [
				{
					"name": "LimpiarTextoViajes"
				},
				{
					"name": "ConvertirDatosViajes"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ViajesBronze",
				"ViajesBronze derive(ViajeId = trim(ViajeId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          VehiculoId = trim(VehiculoId),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> LimpiarTextoViajes",
				"LimpiarTextoViajes derive(FechaServicio = iif(     isInteger(trim(FechaServicio)),     addDays(toDate('1899-12-30'), toInteger(trim(FechaServicio))),     iif(         instr(trim(FechaServicio), '/') > 0,         toDate(trim(FechaServicio), 'dd/MM/yyyy'),         toDate(trim(FechaServicio), 'yyyy-MM-dd')     ) ),",
				"          HoraProgramada = trim(HoraProgramada),",
				"          HoraSalida = trim(HoraSalida),",
				"          HoraLlegada = trim(HoraLlegada),",
				"          ValidacionesTarjeta = toInteger(ValidacionesTarjeta),",
				"          KmRecorridos = toDecimal(replace(trim(KmRecorridos), ',', '.'), 18, 2)) ~> ConvertirDatosViajes",
				"ConvertirDatosViajes sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          SilverId as long,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as date,",
				"          HoraProgramada as timestamp,",
				"          HoraSalida as timestamp,",
				"          HoraLlegada as timestamp,",
				"          ValidacionesTarjeta as integer,",
				"          KmRecorridos as decimal(8,1),",
				"          EstadoViaje as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          ViajeId,",
				"          RutaHistoricaId,",
				"          VehiculoId,",
				"          FechaServicio,",
				"          HoraProgramada,",
				"          HoraSalida,",
				"          HoraLlegada,",
				"          ValidacionesTarjeta,",
				"          KmRecorridos,",
				"          EstadoViaje",
				"     )) ~> DestinoSilverViajes"
			]
		}
	}
}