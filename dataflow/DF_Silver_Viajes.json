{
	"name": "DF_Silver_Viajes",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_DW_Bronce_Viajes",
						"type": "DatasetReference"
					},
					"name": "ViajesBronze"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "LimpiarTextoViajes"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          ViajeId as string,",
				"          RutaHistoricaId as string,",
				"          VehiculoId as string,",
				"          FechaServicio as string,",
				"          HoraProgramada as string,",
				"          HoraSalida as string,",
				"          HoraLlegada as string,",
				"          ValidacionesTarjeta as string,",
				"          KmRecorridos as string,",
				"          EstadoViaje as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ViajesBronze",
				"ViajesBronze derive(ViajeId = trim(ViajeId),",
				"          RutaHistoricaId = trim(RutaHistoricaId),",
				"          VehiculoId = trim(VehiculoId),",
				"          EstadoViaje = upper(trim(EstadoViaje))) ~> LimpiarTextoViajes"
			]
		}
	}
}