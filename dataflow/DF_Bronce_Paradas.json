{
	"name": "DF_Bronce_Paradas",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_CSV_Paradas",
						"type": "DatasetReference"
					},
					"name": "ParadasCSV"
				},
				{
					"name": "ParadasExcel2022"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "SelectParadasCSV"
				}
			],
			"scriptLines": [
				"source(output(",
				"          nro_parada as string,",
				"          nombre_parada as string,",
				"          zona as string,",
				"          latitud as string,",
				"          longitud as string,",
				"          fecha_desde as string,",
				"          fecha_hasta as string,",
				"          estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> ParadasCSV",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> ParadasExcel2022",
				"ParadasCSV select(mapColumn(",
				"          CodigoPublicado = nro_parada,",
				"          NombreParada = nombre_parada,",
				"          Zona = zona,",
				"          Latitud = latitud,",
				"          Longitud = longitud,",
				"          VigenciaDesde = fecha_desde,",
				"          VigenciaHasta = fecha_hasta,",
				"          Estado = estado",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SelectParadasCSV"
			]
		}
	}
}