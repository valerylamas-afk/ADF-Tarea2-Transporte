		{
			"name": "[concat(parameters('factoryName'), '/DF_Bronce_Viajes')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_CSV_Viajes",
								"type": "DatasetReference"
							},
							"name": "ViajesCSV"
						},
						{
							"dataset": {
								"referenceName": "DS_Excel_Operacion2022",
								"type": "DatasetReference"
							},
							"name": "ViajesExcel2022"
						},
						{
							"dataset": {
								"referenceName": "DS_Excel_Operacion2023",
								"type": "DatasetReference"
							},
							"name": "ViajesExcel2023"
						},
						{
							"dataset": {
								"referenceName": "DS_SQL_Viajes_ERP",
								"type": "DatasetReference"
							},
							"name": "ViajesSQL"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_DW_Bronce_Viajes",
								"type": "DatasetReference"
							},
							"name": "SinkBronceViajes"
						}
					],
					"transformations": [
						{
							"name": "SelectCSV"
						},
						{
							"name": "SelectExcel2022"
						},
						{
							"name": "SelectExcel2023"
						},
						{
							"name": "SelectSQL"
						},
						{
							"name": "UnionCSV2022"
						},
						{
							"name": "UnionCSV2022y2023"
						},
						{
							"name": "UnionBronceViajes"
						},
						{
							"name": "DerivarAnioCSV"
						},
						{
							"name": "DerivarAnioExcel2022"
						},
						{
							"name": "DerivarAnioExcel2023"
						}
					],
					"scriptLines": [
						"source(output(",
						"          id_viaje as string,",
						"          cod_ruta as string,",
						"          nro_bus as string,",
						"          fec_servicio as string,",
						"          hora_programada as string,",
						"          hora_salida as string,",
						"          hora_llegada as string,",
						"          pasajeros_reportados as string,",
						"          km_recorridos as string,",
						"          estado_viaje as string,",
						"          tipo_metrica as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ViajesCSV",
						"source(output(",
						"          id_viaje as string,",
						"          cod_ruta as string,",
						"          nro_bus as string,",
						"          fecha_servicio as string,",
						"          hora_programada as string,",
						"          hora_salida as string,",
						"          hora_llegada as string,",
						"          pasajeros_estimados as string,",
						"          km_recorridos as string,",
						"          estado_viaje as string,",
						"          tipo_metrica as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ViajesExcel2022",
						"source(output(",
						"          id_viaje as string,",
						"          cod_ruta as string,",
						"          nro_bus as string,",
						"          fecha_servicio as string,",
						"          hora_programada as string,",
						"          hora_salida as string,",
						"          hora_llegada as string,",
						"          pasajeros_estimados as string,",
						"          km_recorridos as string,",
						"          estado_viaje as string,",
						"          tipo_metrica as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ViajesExcel2023",
						"source(output(",
						"          AnioFuente as string,",
						"          ViajeId as string,",
						"          RutaHistoricaId as string,",
						"          VehiculoId as string,",
						"          FechaServicio as string,",
						"          HoraProgramada as string,",
						"          HoraSalida as string,",
						"          HoraLlegada as string,",
						"          ValidacionesTarjeta as string,",
						"          KmRecorridos as string,",
						"          EstadoViaje as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> ViajesSQL",
						"ViajesCSV select(mapColumn(",
						"          ViajeId = id_viaje,",
						"          RutaHistoricaId = cod_ruta,",
						"          VehiculoId = nro_bus,",
						"          FechaServicio = fec_servicio,",
						"          HoraProgramada = hora_programada,",
						"          HoraSalida = hora_salida,",
						"          HoraLlegada = hora_llegada,",
						"          KmRecorridos = km_recorridos,",
						"          EstadoViaje = estado_viaje",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectCSV",
						"ViajesExcel2022 select(mapColumn(",
						"          ViajeId = id_viaje,",
						"          RutaHistoricaId = cod_ruta,",
						"          VehiculoId = nro_bus,",
						"          FechaServicio = fecha_servicio,",
						"          HoraProgramada = hora_programada,",
						"          HoraSalida = hora_salida,",
						"          HoraLlegada = hora_llegada,",
						"          KmRecorridos = km_recorridos,",
						"          EstadoViaje = estado_viaje",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectExcel2022",
						"ViajesExcel2023 select(mapColumn(",
						"          ViajeId = id_viaje,",
						"          RutaHistoricaId = cod_ruta,",
						"          VehiculoId = nro_bus,",
						"          FechaServicio = fecha_servicio,",
						"          HoraProgramada = hora_programada,",
						"          HoraSalida = hora_salida,",
						"          HoraLlegada = hora_llegada,",
						"          KmRecorridos = km_recorridos,",
						"          EstadoViaje = estado_viaje",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectExcel2023",
						"ViajesSQL select(mapColumn(",
						"          ViajeId,",
						"          RutaHistoricaId,",
						"          VehiculoId,",
						"          FechaServicio,",
						"          HoraProgramada,",
						"          HoraSalida,",
						"          HoraLlegada,",
						"          KmRecorridos,",
						"          EstadoViaje,",
						"          AnioFuente",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectSQL",
						"DerivarAnioCSV, DerivarAnioExcel2022 union(byName: true)~> UnionCSV2022",
						"UnionCSV2022, DerivarAnioExcel2023 union(byName: true)~> UnionCSV2022y2023",
						"UnionCSV2022y2023, SelectSQL union(byName: true)~> UnionBronceViajes",
						"SelectCSV derive(AnioFuente = substring(FechaServicio, 6, 4)) ~> DerivarAnioCSV",
						"SelectExcel2022 derive(AnioFuente = '2022') ~> DerivarAnioExcel2022",
						"SelectExcel2023 derive(AnioFuente = '2023') ~> DerivarAnioExcel2023",
						"UnionBronceViajes sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as string,",
						"          ViajeId as string,",
						"          RutaHistoricaId as string,",
						"          VehiculoId as string,",
						"          FechaServicio as string,",
						"          HoraProgramada as string,",
						"          HoraSalida as string,",
						"          HoraLlegada as string,",
						"          ValidacionesTarjeta as string,",
						"          KmRecorridos as string,",
						"          EstadoViaje as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          ViajeId,",
						"          RutaHistoricaId,",
						"          VehiculoId,",
						"          FechaServicio,",
						"          HoraProgramada,",
						"          HoraSalida,",
						"          HoraLlegada,",
						"          KmRecorridos,",
						"          EstadoViaje",
						"     )) ~> SinkBronceViajes"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/DS_CSV_Viajes')]",
				"[concat(variables('factoryId'), '/datasets/DS_Excel_Operacion2022')]",
				"[concat(variables('factoryId'), '/datasets/DS_Excel_Operacion2023')]",
				"[concat(variables('factoryId'), '/datasets/DS_SQL_Viajes_ERP')]",
				"[concat(variables('factoryId'), '/datasets/DS_DW_Bronce_Viajes')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/Pipeline_Bronze')]",
