{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-transporte-valery-2026"
		},
		"LS_AzureBlobStorage_connectionString": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"connectionString\"de \"LS_AzureBlobStorage\""
		},
		"LS_AzureSQL_DW_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"LS_AzureSQL_DW\""
		},
		"LS_AzureSQL_ERP_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"LS_AzureSQL_ERP\""
		},
		"LS_AzureSQL_DW_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-transporte-valery-2026-cus.database.windows.net"
		},
		"LS_AzureSQL_DW_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_transporte"
		},
		"LS_AzureSQL_DW_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admintransporte"
		},
		"LS_AzureSQL_ERP_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-transporte-valery-2026-cus.database.windows.net"
		},
		"LS_AzureSQL_ERP_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "erp_transporte_db"
		},
		"LS_AzureSQL_ERP_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "admintransporte"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/LS_AzureBlobStorage')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureBlobStorage",
				"typeProperties": {
					"connectionString": "[parameters('LS_AzureBlobStorage_connectionString')]"
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_AzureSQL_DW')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_AzureSQL_DW_properties_typeProperties_server')]",
					"database": "[parameters('LS_AzureSQL_DW_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_AzureSQL_DW_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_AzureSQL_DW_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/LS_AzureSQL_ERP')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('LS_AzureSQL_ERP_properties_typeProperties_server')]",
					"database": "[parameters('LS_AzureSQL_ERP_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('LS_AzureSQL_ERP_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('LS_AzureSQL_ERP_password')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/DS_CSV_Viajes')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
