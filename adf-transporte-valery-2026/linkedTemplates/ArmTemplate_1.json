{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-transporte-valery-2026"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/DF_Bronce_Paradas')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_CSV_Paradas",
								"type": "DatasetReference"
							},
							"name": "ParadasCSV"
						},
						{
							"dataset": {
								"referenceName": "DS_Excel_Paradas2022",
								"type": "DatasetReference"
							},
							"name": "ParadasExcel2022"
						},
						{
							"dataset": {
								"referenceName": "DS_Excel_Paradas2023",
								"type": "DatasetReference"
							},
							"name": "ParadasExcel2023"
						},
						{
							"dataset": {
								"referenceName": "DS_SQL_Paradas_ERP",
								"type": "DatasetReference"
							},
							"name": "ParadasSQL"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_DW_Bronce_Paradas",
								"type": "DatasetReference"
							},
							"name": "SinkBronceParadas"
						}
					],
					"transformations": [
						{
							"name": "SelectParadasCSV"
						},
						{
							"name": "SelectParadasExcel2022"
						},
						{
							"name": "SelectParadasExcel2023"
						},
						{
							"name": "ConvertirTiposParadasSQL"
						},
						{
							"name": "SelectParadasSQL"
						},
						{
							"name": "DerivarTiposParadasSQL"
						},
						{
							"name": "UnionParadas2022"
						},
						{
							"name": "UnionParadas2023"
						},
						{
							"name": "UnionBronceParadas"
						}
					],
					"scriptLines": [
						"source(output(",
						"          nro_parada as string,",
						"          nombre_parada as string,",
						"          zona as string,",
						"          latitud as string,",
						"          longitud as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ParadasCSV",
						"source(output(",
						"          nro_parada as string,",
						"          nombre_parada as string,",
						"          zona as string,",
						"          latitud as string,",
						"          longitud as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ParadasExcel2022",
						"source(output(",
						"          nro_parada as string,",
						"          nombre_parada as string,",
						"          zona as string,",
						"          latitud as string,",
						"          longitud as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> ParadasExcel2023",
						"source(output(",
						"          AnioFuente as integer,",
						"          ParadaHistoricaId as string,",
						"          CodigoPublicado as string,",
						"          NombreParada as string,",
						"          Zona as string,",
						"          Latitud as decimal(9,6),",
						"          Longitud as decimal(9,6),",
						"          VigenciaDesde as date,",
						"          VigenciaHasta as date,",
						"          Estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> ParadasSQL",
						"ParadasCSV select(mapColumn(",
						"          CodigoPublicado = nro_parada,",
						"          NombreParada = nombre_parada,",
						"          Zona = zona,",
						"          Latitud = latitud,",
						"          Longitud = longitud,",
						"          VigenciaDesde = fecha_desde,",
						"          VigenciaHasta = fecha_hasta,",
						"          Estado = estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectParadasCSV",
						"ParadasExcel2022 select(mapColumn(",
						"          CodigoPublicado = nro_parada,",
						"          NombreParada = nombre_parada,",
						"          Zona = zona,",
						"          Latitud = latitud,",
						"          Longitud = longitud,",
						"          VigenciaDesde = fecha_desde,",
						"          VigenciaHasta = fecha_hasta,",
						"          Estado = estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectParadasExcel2022",
						"ParadasExcel2023 select(mapColumn(",
						"          CodigoPublicado = nro_parada,",
						"          NombreParada = nombre_parada,",
						"          Zona = zona,",
						"          Latitud = latitud,",
						"          Longitud = longitud,",
						"          VigenciaDesde = fecha_desde,",
						"          VigenciaHasta = fecha_hasta,",
						"          Estado = estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectParadasExcel2023",
						"ParadasSQL select(mapColumn(",
						"          AnioFuente,",
						"          ParadaHistoricaId,",
						"          CodigoPublicado,",
						"          NombreParada,",
						"          Zona,",
						"          Latitud,",
						"          Longitud,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> ConvertirTiposParadasSQL",
						"ConvertirTiposParadasSQL select(mapColumn(",
						"          AnioFuente,",
						"          ParadaHistoricaId,",
						"          CodigoPublicado,",
						"          NombreParada,",
						"          Zona,",
						"          Latitud,",
						"          Longitud,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SelectParadasSQL",
						"SelectParadasSQL derive(AnioFuente = toString(AnioFuente),",
						"          Latitud = toString(Latitud),",
						"          Longitud = toString(Longitud),",
						"          VigenciaDesde = toString(VigenciaDesde),",
						"          VigenciaHasta = toString(VigenciaHasta)) ~> DerivarTiposParadasSQL",
						"SelectParadasCSV, SelectParadasExcel2022 union(byName: true)~> UnionParadas2022",
						"UnionParadas2022, SelectParadasExcel2023 union(byName: true)~> UnionParadas2023",
						"UnionParadas2023, DerivarTiposParadasSQL union(byName: true)~> UnionBronceParadas",
						"UnionBronceParadas sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          AnioFuente as string,",
						"          ParadaHistoricaId as string,",
						"          CodigoPublicado as string,",
						"          NombreParada as string,",
						"          Zona as string,",
						"          Latitud as string,",
						"          Longitud as string,",
						"          VigenciaDesde as string,",
						"          VigenciaHasta as string,",
						"          Estado as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          AnioFuente,",
						"          ParadaHistoricaId,",
						"          CodigoPublicado,",
						"          NombreParada,",
						"          Zona,",
						"          Latitud,",
						"          Longitud,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     )) ~> SinkBronceParadas"
					]
				}
			},
			"dependsOn": []
		},
