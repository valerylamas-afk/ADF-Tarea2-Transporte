					"scriptLines": [
						"source(output(",
						"          cod_ruta as string,",
						"          nombre_ruta as string,",
						"          origen as string,",
						"          destino as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> RutasCSV",
						"source(output(",
						"          cod_ruta as string,",
						"          nombre_ruta as string,",
						"          origen as string,",
						"          destino as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> RutasExcel2022",
						"source(output(",
						"          cod_ruta as string,",
						"          nombre_ruta as string,",
						"          origen as string,",
						"          destino as string,",
						"          fecha_desde as string,",
						"          fecha_hasta as string,",
						"          estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> RutasExcel2023",
						"source(output(",
						"          AnioFuente as string,",
						"          RutaHistoricaId as string,",
						"          CodigoRuta as string,",
