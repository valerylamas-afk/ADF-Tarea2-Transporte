		{
			"name": "[concat(parameters('factoryName'), '/DF_Silver_Rutas')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_DW_Bronce_Rutas",
								"type": "DatasetReference"
							},
							"name": "RutasBronze"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_DW_Silver_Rutas",
								"type": "DatasetReference"
							},
							"name": "DestinoSilverRutas"
						}
					],
					"transformations": [
						{
							"name": "LimpiarTextoRutas"
						},
						{
							"name": "ConvertirFechasRutas"
						}
					],
					"scriptLines": [
						"source(output(",
						"          AnioFuente as string,",
						"          RutaHistoricaId as string,",
						"          CodigoRuta as string,",
						"          NombreRuta as string,",
						"          Origen as string,",
						"          Destino as string,",
						"          VigenciaDesde as string,",
						"          VigenciaHasta as string,",
						"          Estado as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> RutasBronze",
						"RutasBronze derive(RutaHistoricaId = trim(RutaHistoricaId),",
						"          CodigoRuta = trim(CodigoRuta),",
						"          NombreRuta = trim(NombreRuta),",
						"          Origen = trim(Origen),",
						"          Destino = trim(Destino),",
						"          Estado = upper(trim(Estado))) ~> LimpiarTextoRutas",
						"LimpiarTextoRutas derive(VigenciaDesde = iif(     isInteger(trim(VigenciaDesde)),     addDays(toDate('1899-12-30'), toInteger(trim(VigenciaDesde))),     iif(         instr(trim(VigenciaDesde), '/') > 0,         toDate(trim(VigenciaDesde), 'dd/MM/yyyy'),         toDate(trim(VigenciaDesde), 'yyyy-MM-dd')     ) ),",
						"          VigenciaHasta = iif(     isInteger(trim(VigenciaHasta)),     addDays(toDate('1899-12-30'), toInteger(trim(VigenciaHasta))),     iif(         instr(trim(VigenciaHasta), '/') > 0,         toDate(trim(VigenciaHasta), 'dd/MM/yyyy'),         toDate(trim(VigenciaHasta), 'yyyy-MM-dd')     ) )) ~> ConvertirFechasRutas",
						"ConvertirFechasRutas sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          RutaHistoricaId,",
						"          CodigoRuta,",
						"          NombreRuta,",
						"          Origen,",
						"          Destino,",
						"          VigenciaDesde,",
						"          VigenciaHasta,",
						"          Estado",
						"     )) ~> DestinoSilverRutas"
					]
				}
			},
			"dependsOn": []
		},
